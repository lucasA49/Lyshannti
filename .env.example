# Copier en .env et compléter. Ne jamais commiter .env.

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lyshannti"

# URL publique du site, sans « / » final (canoniques, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# « true » uniquement en production sur le domaine définitif
NEXT_PUBLIC_SITE_INDEXABLE="false"

# Seed de développement (npx prisma db seed) : compte admin local
SEED_ADMIN_EMAIL="admin@lyshannti.local"
SEED_ADMIN_PASSWORD="choisir-un-mot-de-passe-de-12-caracteres-minimum"
# « false » pour ne créer que l'admin, les paramètres et les catégories
SEED_DEMO="true"
